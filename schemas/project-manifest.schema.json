{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PortfolioProjectManifest",
  "type": "object",
  "required": [
    "id",
    "title",
    "subtitle",
    "type",
    "duration",
    "location",
    "summary",
    "capabilities",
    "kpis",
    "kpiSummary",
    "carousel",
    "sandbox",
    "blueprint",
    "dnaMap",
    "artifacts",
    "gallery"
  ],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "subtitle": { "type": "string" },
    "type": { "type": "string" },
    "duration": { "type": "string" },
    "location": { "type": "string" },
    "summary": { "type": "string" },
    "capabilities": {
      "type": "array",
      "items": { "type": "string" }
    },
    "kpis": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "value", "subtext"],
        "properties": {
          "label": { "type": "string" },
          "value": { "type": "string" },
          "subtext": { "type": "string" }
        }
      }
    },
    "kpiSummary": {
      "type": "object",
      "required": ["budget", "rates", "outcomes", "challenges"],
      "properties": {
        "budget": { "type": "string" },
        "rates": { "type": "string" },
        "outcomes": { "type": "string" },
        "challenges": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "carousel": {
      "type": "array",
      "minItems": 7,
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["title", "heading", "content"],
        "properties": {
          "title": { "type": "string" },
          "heading": { "type": "string" },
          "content": { "type": "string" }
        }
      }
    },
    "sandbox": {
      "type": "object",
      "required": [
        "title",
        "explanation",
        "formulaId",
        "slider1",
        "slider2",
        "slider3",
        "outputs"
      ],
      "properties": {
        "title": { "type": "string" },
        "explanation": { "type": "string" },
        "formulaId": {
          "type": "string",
          "enum": [
            "infinity_belize",
            "valet_vault_saas",
            "conyers_sports_academy",
            "healthquest_campaign",
            "ara_survey_campaign",
            "inspired_campaign",
            "o2_development"
          ]
        },
        "slider1": { "$ref": "#/definitions/sliderConfig" },
        "slider2": { "$ref": "#/definitions/sliderConfig" },
        "slider3": { "$ref": "#/definitions/sliderConfig" },
        "outputs": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "type": "string" }
        }
      }
    },
    "blueprint": {
      "type": "object",
      "required": ["title", "phases", "entities"],
      "properties": {
        "title": { "type": "string" },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "desc"],
            "properties": {
              "label": { "type": "string" },
              "desc": { "type": "string" }
            }
          }
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "connection", "to"],
            "properties": {
              "from": { "type": "string" },
              "connection": { "type": "string" },
              "to": { "type": "string" }
            }
          }
        }
      }
    },
    "dnaMap": {
      "type": "object",
      "required": ["title", "nodes"],
      "properties": {
        "title": { "type": "string" },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "category", "detail", "relatedArtifactIds"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "category": { "type": "string" },
              "detail": { "type": "string" },
              "relatedArtifactIds": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "category",
          "type",
          "summary",
          "status",
          "sensitivity",
          "parties",
          "relatedNodeIds",
          "viewer"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "category": { "type": "string" },
          "type": { "type": "string" },
          "summary": { "type": "string" },
          "status": { "type": "string", "enum": ["preview", "restricted"] },
          "sensitivity": {
            "type": "string",
            "enum": ["public-preview", "redacted", "confidential"]
          },
          "parties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "relatedNodeIds": {
            "type": "array",
            "items": { "type": "string" }
          },
          "viewer": {
            "type": "object",
            "required": ["kind"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["html", "image", "pages", "gallery", "video", "none"]
              },
              "src": { "type": "string" },
              "alt": { "type": "string" },
              "poster": { "type": "string" },
              "images": {
                "type": "array",
                "items": { "type": "string" }
              },
              "sources": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["src"],
                  "properties": {
                    "src": { "type": "string" },
                    "type": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "gallery": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "caption", "category", "visibility"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "caption": { "type": "string" },
          "imageSrc": { "type": "string" },
          "alt": { "type": "string" },
          "category": { "type": "string" },
          "parties": {
            "type": "array",
            "items": { "type": "string" }
          },
          "date": { "type": "string" },
          "role": { "type": "string" },
          "visibility": {
            "type": "string",
            "enum": ["public-preview", "redacted"]
          },
          "relatedArtifactIds": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "definitions": {
    "sliderConfig": {
      "type": "object",
      "required": ["label", "min", "max", "step", "default"],
      "properties": {
        "label": { "type": "string" },
        "min": { "type": "number" },
        "max": { "type": "number" },
        "step": { "type": "number" },
        "default": { "type": "number" }
      }
    }
  }
}
